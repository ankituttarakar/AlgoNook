# Production required variables (configure in Vercel, never commit values)
DATABASE_URL=
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
CODE_RUNNER_URL=
CODE_RUNNER_SECRET=

# Optional live YouTube Shorts discovery (if omitted, high-quality curated DSA fallback pool is used)
YOUTUBE_API_KEY=

# Local development (use the same variable names in ignored app/.env.local,
# with isolated development credentials/data; CODE_RUNNER_* can be omitted
# when using the local Docker runner)

# Optional local runner service settings
RUNNER_MAX_CONCURRENCY=
PORT=
RUNNER_BIND_ADDRESS=

# QA-only settings (set in shell; never use production targets/data)
QA_BASE_URL=
QA_TARGET_ENV=
QA_DATA_ENV=
QA_AUTH_STATE=auth.json
QA_EXPECTED_CLERK_USER_ID=
QA_PREVIEW_HOSTS=
QA_STAGING_HOSTS=
QA_SAFE_DATABASE_HOSTS=
