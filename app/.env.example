# Neon PostgreSQL Connection String (Server-side only — never prefix with VITE_)
DATABASE_URL=your_neon_connection_string

# Clerk Authentication (Client Publishable Key)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Clerk Server Secret Key (Server-side only for token verification — NEVER prefix with VITE_)
CLERK_SECRET_KEY=sk_test_...
